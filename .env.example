DATABASE_URL=mysql+pymysql://taskflow:change-me@127.0.0.1:3306/taskflow?charset=utf8mb4
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Docker Compose uses these values; set strong unique passwords in .env.
MYSQL_DATABASE=taskflow
MYSQL_USER=taskflow
MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-root-password
FRONTEND_BIND_IP=127.0.0.1
FRONTEND_PORT=8080
